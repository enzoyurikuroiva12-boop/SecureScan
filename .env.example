# Keep the API bound to loopback for this single-user MVP.
SECURESCAN_DATA_DIR=./data
SECURESCAN_DATABASE_URL=sqlite:///./data/securescan.db
SECURESCAN_MAX_UPLOAD_BYTES=52428800
SECURESCAN_MAX_ARCHIVE_FILES=8000
SECURESCAN_MAX_EXTRACTED_BYTES=209715200
SECURESCAN_MAX_SINGLE_FILE_BYTES=26214400
SECURESCAN_SCANNER_TIMEOUT_SECONDS=90

# Frontend may use this value when served from a different local origin.
# VITE_API_URL=http://127.0.0.1:8000/api/v1
